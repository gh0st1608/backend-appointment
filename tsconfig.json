{
    "compilerOptions": {
        "target": "ES2021",
        "module": "commonjs",
        "lib": [
            "ES2021"
        ],
        "outDir": "dist",
        "rootDir": "src",
        "strict": true,
        "esModuleInterop": true,
        "experimentalDecorators": true,
        "emitDecoratorMetadata": true,
        "skipLibCheck": true,
        "resolveJsonModule": true,
        "strictBindCallApply": true,
        "strictNullChecks": false,
        "forceConsistentCasingInFileNames": true,
        "types": [
            "node",
            "jest"
        ]
    }
}